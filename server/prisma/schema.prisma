// Prisma schema for collaborative editor chat and rooms
// Using SQLite by default; can switch provider to postgresql or mysql later

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Room {
  id        String    @id @default(cuid())
  code      String    @unique // room code used by clients
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  messages  Message[]
}

model User {
  id        String    @id @default(cuid())
  username  String
  room      Room      @relation(fields: [roomId], references: [id])
  roomId    String
  createdAt DateTime  @default(now())

  @@unique([username, roomId]) // username unique within a room
}

model Message {
  id        String    @id @default(cuid())
  room      Room      @relation(fields: [roomId], references: [id])
  roomId    String
  username  String
  body      String
  timestamp DateTime  @default(now())

  @@index([roomId, timestamp])
}
